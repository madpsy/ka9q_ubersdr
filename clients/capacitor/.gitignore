# Staged by build.sh: the v2 bundle, the chooser page, Leaflet, and the
# window.ubersdr bundle. All of it is built from sources elsewhere in the
# repository — see build.sh — and none of it is edited here.
www/

node_modules/

# The APK, under the fixed name --publish uploads.
dist/

# Signing keys, if one is ever put here.
#
# The keystore belongs outside the repository — build.sh reads its path from
# UBERSDR_KEYSTORE and the working default is ~/keys/ — so this should never
# match anything. It is here because the one mistake that cannot be undone by a
# later commit is publishing the key that identifies this app: anyone holding it
# can ship an update that installs straight over somebody's copy.
*.jks
*.keystore
*.p12
*.password

# android/.gitignore (generated by Capacitor) already covers the Gradle
# outputs, local.properties and the copied web assets.

# Generated by build.sh from clients/electron/assets/icon.png — the same mark
# the desktop client uses, at the sizes Android asks for.
android/app/src/main/res/mipmap-*/ic_launcher.png
android/app/src/main/res/mipmap-*/ic_launcher_round.png
android/app/src/main/res/mipmap-*/ic_launcher_foreground.png

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- `appCategory` is what Android groups this app under where it groups
         apps by what they are: battery and mobile-data attribution in Settings,
         and Digital Wellbeing. Undeclared, it lands in "Other" beside
         everything else that never said — a poor answer for the app on the
         phone most likely to be asked why the battery went.

         `audio` rather than `productivity`, which is not the same choice as the
         iOS category next door (Utilities), and deliberately. The two keys
         answer different questions: Apple's is which shelf this belongs on in a
         shop, where "a tool for reaching someone else's radio" is a utility.
         Android's is what this app *does to the device*, and what it does is
         play audio for hours with the screen off — it already declares a
         `mediaPlayback` foreground service and puts controls on the lock
         screen. Somebody looking through the battery list for what has been
         playing all afternoon should find it where the other players are. -->
    <application
        android:allowBackup="true"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              ubersdr://connect?uuid=<public uuid> — a receiver, named by the
              UUID the directory knows it as, from anywhere the phone can follow
              a link: a QR code, a message, an instance's own page.

              The filter is the scheme alone rather than scheme + host. What the
              link asks for is then src/deeplink.js's to read and to refuse,
              which is where a mistyped link can be answered with a sentence
              instead of Android silently offering the browser instead. It also
              means a second kind of link later is a change to one file.

              MainActivity is singleTask, so a link followed while the app is
              already running arrives at the instance that exists — see
              UberSdrPlugin.handleOnNewIntent — rather than starting a second
              chooser beside it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ubersdr" />
            </intent-filter>

        </activity>

        <!--
          A receiver, in its own task entry.

          configChanges is the whole list the chooser carries plus the same
          reasoning it does not need: a rotation that recreated this Activity
          would destroy the WebView, and destroying the WebView stops the audio
          and drops the session. Turning the phone must not disconnect the
          receiver.
        -->
        <activity
            android:name=".ReceiverActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="false" />

        <!--
          What keeps a receiver playing once the screen locks. Without it the
          process is cacheable the moment the Activity stops being visible, and
          a frozen process is silence.

          The type is mediaPlayback because that is what it is doing, and from
          Android 14 the platform checks: a service of this type must have an
          active MediaSession, which PlaybackService creates.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Playing on with the screen off, and the notification that says so.
         POST_NOTIFICATIONS is a runtime permission from Android 13: refused, the
         service still runs and the audio still plays, but the operator gets no
         notification to stop it from — so ReceiverActivity asks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for saving an export — a recording, a decoder log — into the
         Downloads folder, and only on Android 9 and earlier, where that meant
         writing a real file. From Android 10 a download is a MediaStore row
         and needs no permission at all, which is what maxSdkVersion says here:
         asking beyond 28 would be asking for something the app does not use
         and the Play listing would have to justify. See Downloads.java. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>

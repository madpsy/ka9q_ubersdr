<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          A receiver, in its own task entry.

          configChanges is the whole list the chooser carries plus the same
          reasoning it does not need: a rotation that recreated this Activity
          would destroy the WebView, and destroying the WebView stops the audio
          and drops the session. Turning the phone must not disconnect the
          receiver.
        -->
        <activity
            android:name=".ReceiverActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="false" />

        <!--
          What keeps a receiver playing once the screen locks. Without it the
          process is cacheable the moment the Activity stops being visible, and
          a frozen process is silence.

          The type is mediaPlayback because that is what it is doing, and from
          Android 14 the platform checks: a service of this type must have an
          active MediaSession, which PlaybackService creates.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Playing on with the screen off, and the notification that says so.
         POST_NOTIFICATIONS is a runtime permission from Android 13: refused, the
         service still runs and the audio still plays, but the operator gets no
         notification to stop it from — so ReceiverActivity asks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>

# Amateur Radio Band configuration file for ka9q UberSDR
# Each band has a label (name), start frequency, and end frequency (in Hz)
# Optionally, bands can be assigned to a group for organization
# Based on UK amateur radio band allocations from Ofcom
#
# The group is free text and purely for organising the band list, with one
# exception: "blocked" (any capitalisation) closes the range to ordinary
# listeners. Instead of demodulated audio they hear a short recording on a
# loop, and IQ modes are refused there so the raw signal cannot be taken off
# the receiver instead. Users who bypass session limits — an IP in
# server.timeout_bypass_ips, or a client supplying server.bypass_password —
# hear the range normally, as do the decoders and the noise-floor monitor.
#
# The recordings are read at startup from audio/blocked-12.wav and
# audio/blocked-24.wav: 16-bit mono WAV at 12 kHz and 24 kHz, matching the two
# rates this server demodulates at (12 kHz for SSB/CW, 24 kHz for AM/FM). If a
# file is missing, the modes at that rate are served normally rather than
# silenced, and the startup log says so.
#
# Blocked ranges are ordinary bands in every other respect: they appear in the
# band list and on the spectrum like any other entry, and can be added, edited
# and deleted from the admin Bands tab without a restart. For example:
#
#   - label: "Medium wave"
#     start: 526500          # ITU Region 1 MW broadcast band
#     end: 1606500           # Region 2 is 525000-1705000
#     group: "Blocked"

bands:
  # HF Amateur Radio Bands (UK Allocations)
  - label: "160m"
    start: 1810000
    end: 2000000
    group: "HF"

  - label: "80m"
    start: 3500000
    end: 3800000
    group: "HF"

  - label: "60m"
    start: 5258500
    end: 5406500
    group: "HF"

  - label: "40m"
    start: 7000000
    end: 7200000
    group: "HF"

  - label: "30m"
    start: 10100000
    end: 10150000
    group: "HF"

  - label: "20m"
    start: 14000000
    end: 14350000
    group: "HF"

  - label: "17m"
    start: 18068000
    end: 18168000
    group: "HF"

  - label: "15m"
    start: 21000000
    end: 21450000
    group: "HF"

  - label: "12m"
    start: 24890000
    end: 24990000
    group: "HF"

  - label: "10m"
    start: 28000000
    end: 29700000
    group: "HF"

  # 6m — only reachable when the RX888 runs at its full 129.6 MSPS. A receiver whose
  # front end does not reach this far drops the band at startup and carries on, so this
  # entry is harmless at 64.8 MSPS and starts working by itself if the sample rate is
  # raised. Nothing needs commenting out either way.
  #
  # Grouped VHF rather than HF because that is what it is; the group is a free-text
  # label used only to organise the admin list.
  - label: "6m"
    start: 50000000
    end: 52000000
    group: "VHF"

  # 6m sub-bands, from the IARU Region 1 plan. They overlap the whole-band entry above on
  # purpose: that one is for moving to the band, these are for landing on the part of it
  # you actually want.
  - label: "6m CW"
    start: 50000000
    end: 50100000
    group: "VHF"

  - label: "6m SSB"
    start: 50100000
    end: 50300000
    group: "VHF"

  - label: "6m Digital"
    start: 50300000
    end: 50400000
    group: "VHF"

  - label: "6m Beacons"
    start: 50400000
    end: 50500000
    group: "VHF"

  - label: "6m FM"
    start: 50500000
    end: 52000000
    group: "VHF"

  # Non-amateur VHF allocations, listed because a receiver that reaches this far can hear
  # them and they are what most of the activity between 30 and 50 MHz actually is. Like
  # 6m above, they need the RX888 at its full 129.6 MSPS and are dropped at startup on a
  # narrower front end.

  # UK aeromodelling — RC aircraft
  - label: "35 MHz RC"
    start: 34945000
    end: 35305000
    group: "Model Control"

  # UK surface model control — cars and boats
  - label: "40 MHz RC"
    start: 40660000
    end: 41000000
    group: "Model Control"

  # Licence-exempt short-range devices and model control
  - label: "49 MHz SRD"
    start: 49820000
    end: 49980000
    group: "Model Control"

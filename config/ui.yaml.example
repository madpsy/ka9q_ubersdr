# UberSDR Web UI Defaults
# These settings control the default appearance for all new visitors.
# Individual users can override any of these via the UI controls,
# and their personal preference is saved in browser localStorage.
# The server default only applies when a user has no saved preference for that setting.
#
# To add a new palette (after implementing it in spectrum-display.js):
#   Simply add a new entry to the palette.available list below.
#   It will automatically appear as an option in the admin UI.
#   No Go code or HTML changes are required.

ui:
  # Serve the v2 interface to visitors.
  # When true, / and /index.html redirect to /v2/ before any of the classic
  # page is sent, so there is no flash of the old UI. Unlike everything else
  # in this file this is not a per-user default — it applies to everyone.
  # The classic interface stays reachable at /?v1 while this is enabled.
  # Toggled live from the admin UI tab; no restart required.
  #
  # True here so a new installation starts on v2. Receivers that were installed
  # before this key existed are left on the classic interface by the entrypoint
  # rather than being moved on upgrade — see docker/entrypoint.sh.
  v2_interface: true

  # Default signal bar meter mode for new visitors
  # The signal bar meter sits under the waterfall and shows signal strength
  # Users can click the meter to cycle through modes
  # localStorage key: signalMeterDisplayMode
  signal_meter_mode:
    default: "dbfs"
    available:
      - value: "dbfs"
        label: "dBFS Bar"
      - value: "snr"
        label: "SNR Bar"
      - value: "dbfs-led"
        label: "dBFS LED"
      - value: "snr-led"
        label: "SNR LED"

  # Default S-meter display mode for new visitors
  # Controls which mode the needle S-meter (canvas) starts in
  # Users can click the S-meter canvas to cycle through modes
  # localStorage key: ubersdr_smeter_colour_mode
  smeter_mode:
    default: "smeter-classic"
    available:
      - value: "smeter-classic"
        label: "S-Meter (Classic)"
      - value: "snr-classic"
        label: "SNR Meter (Classic)"
      - value: "smeter-dynamic"
        label: "S-Meter (Dynamic colour)"
      - value: "snr-dynamic"
        label: "SNR Meter (Dynamic colour)"

  # Default waterfall colour palette for new visitors
  # localStorage key: spectrumColorScheme
  # To add a new palette: add an entry to 'available' below (after adding it to spectrum-display.js)
  palette:
    default: "jet"
    available:
      - value: "jet"
        label: "Jet"
      - value: "turbo"
        label: "Turbo"
      - value: "viridis"
        label: "Viridis"
      - value: "plasma"
        label: "Plasma"
      - value: "sonar-green"
        label: "Sonar 1"
      - value: "sonar-orange"
        label: "Sonar 2"
      - value: "night-vision"
        label: "Night"

  # Default auto-contrast value for new visitors
  # Symmetric dB offset applied to the auto-range window:
  #   floor is raised by +N dB, ceiling is lowered by -N dB
  # Range: 0-20 (matches the Contrast slider in the spectrum controls)
  # localStorage key: spectrumAutoContrast
  contrast:
    default: 10
    min: 0
    max: 20

  # Default VU meter display style for new visitors
  # localStorage key: vuMeterStyle
  vu_meter_style:
    default: "bar"
    available:
      - value: "bar"
        label: "Bar"
      - value: "led"
        label: "LED"

  # Default GPU sub-pixel waterfall scroll for new visitors
  # Smoother 60fps scrolling using CSS transform compositing
  # Disable if users report visual glitches on older hardware
  # localStorage key: spectrumGpuScrollEnabled
  gpu_scroll:
    default: true

  # Default spatial smoothing for new visitors
  # Reduces noise fuzziness in the spectrum display
  # localStorage key: spectrumSmoothEnabled
  smoothing:
    default: false

  # Default peak hold for new visitors
  # Shows the highest signal level reached in the spectrum display
  # localStorage key: spectrumHoldEnabled
  peak_hold:
    default: true

  # Default spectrum split view for new visitors
  # Shows a spectrum line graph above the waterfall in a split-screen layout
  # Corresponds to the 'Spectrum' checkbox in the UI controls
  # localStorage key: spectrumLineGraphEnabled
  line_graph:
    default: false

  # Default bandwidth indicator colour for new visitors
  # The coloured bar drawn on the waterfall/overlay canvas showing the tuned receive bandwidth.
  # Users can right-click the bandwidth indicator bar to change the colour; their choice is
  # saved in browser localStorage and always takes priority over this server default.
  # localStorage key: bandwidthIndicatorColor
  bandwidth_indicator_color:
    default: "green"
    available:
      - value: "green"
        label: "Green (default)"
      - value: "red"
        label: "Red"
      - value: "cyan"
        label: "Cyan"
      - value: "white"
        label: "White"
      - value: "yellow"
        label: "Yellow"
      - value: "orange"
        label: "Orange"
      - value: "magenta"
        label: "Magenta"

  # Band colour intensity for the amateur band overlays in the bookmark area.
  # Controls how vivid the coloured band backgrounds appear on the spectrum.
  # Valid range: 0.5–1.0.
  # 0.5 = default pastel (alpha 0.20, floor 100 — original appearance)
  # 1.0 = vivid (alpha 0.80, floor 0 — bold, fully saturated colours)
  # No localStorage key — this is an operator setting; users cannot override it individually.
  band_color_intensity: 0.5

  # Opacity of the docked receiver controls overlay (#dock-overlay-wrapper).
  # The waterfall controls bar at the bottom of the waterfall (.spectrum-display-controls)
  # is always 15% more opaque than this value, capped at 1.0.
  # Valid range: 0.0–1.0.
  # 0.50 = default (matches the original hardcoded appearance)
  # Applied as CSS custom properties --controls-opacity and --waterfall-controls-opacity on :root.
  # No localStorage key — this is a server-wide operator setting; users cannot override it individually.
  controls_opacity: 0.50

  # Station ID overlay on the spectrum line graph
  # When enabled, shows "<callsign> - <name>" on the first line and "<location>" on the
  # second line, right-aligned in the top-right corner of the spectrum drawing area.
  # Values come from the admin > Station Info section (callsign, name, location fields).
  # This is a server-side operator setting — users cannot override it individually.
  # No localStorage key.
  station_id_overlay: true

  # Hex colour for the station ID overlay text (#rrggbb).
  # The location line is drawn at 75% opacity of this colour.
  # A 1 px black drop-shadow is always added for legibility over any background.
  station_id_color: "#ffffff"

  # Theme colour overrides — all values are 6-digit hex colours (#rrggbb).
  # When absent the built-in defaults reproduce the original appearance exactly.
  # theme:
  #   page_bg:      "#adb5bd"  # Background of panels below the waterfall
  #   panel_dark:   "#2c3e50"  # Dark widget backgrounds (S-meter, canvases, modals)
  #   panel_mid:    "#34495e"  # Section headers, control group backgrounds
  #   accent:       "#667eea"  # Hover states, primary buttons, gradient start
  #   accent_end:   "#764ba2"  # End colour of accent gradients
  #   text_light:   "#ecf0f1"  # Text on dark panel backgrounds
  #   control_text: "#495057"  # Labels on light backgrounds (Volume, Left, Right, Low, High, Scroll…)

  # Default mobile frequency console for new visitors on narrow/mobile screens (≤1024 px wide).
  # Controls whether the tuning buttons or the drag wheel is shown by default.
  # Users can switch at any time using the Btns/Wheel radio toggle in the frequency controls.
  # localStorage key: tuningMode
  mobile_tuning_mode:
    default: "buttons"
    available:
      - value: "buttons"
        label: "Buttons"
      - value: "wheel"
        label: "Wheel"

  # Default audio buffer threshold for new visitors.
  # Sets the maximum audio buffer size before frames are dropped.
  # Users can change this at any time via the Audio Settings modal (click the buffer indicator).
  # localStorage key: audioBufferThreshold
  default_buffer:
    default: "200"
    available:
      - value: "50"
        label: "50ms (Lowest latency)"
      - value: "100"
        label: "100ms"
      - value: "150"
        label: "150ms"
      - value: "200"
        label: "200ms (Default)"
      - value: "300"
        label: "300ms"
      - value: "500"
        label: "500ms (Most stable)"

  # Origins allowed to send postMessage commands to this SDR (cross-origin iframes/popups).
  # Enables external pages (e.g. a DX cluster or logging application) to control the SDR's
  # frequency and mode via the browser postMessage API when embedded in an <iframe> or popup.
  # Each entry must be a full origin: scheme + host (+ optional port), with no trailing slash
  # or path component. Only http:// and https:// are accepted; wildcards are not supported.
  # Leave empty (or omit entirely) to allow same-origin control only.
  # Example:
  # allowed_postmessage_origins:
  #   - "https://my-cluster.example.com"
  #   - "https://other-trusted-site.net"
  #   - "http://localhost:8080"
  allowed_postmessage_origins: []

  # ── v2 interface defaults ───────────────────────────────────────────────────
  #
  # Everything above this block belongs to the classic interface, or is read by
  # both; this block is read only by v2. They are separate because several keys
  # that look shared are not: `contrast` above is a symmetric dB offset on the
  # auto-range window, while v2's below is a gamma on the amplitude-to-colour
  # mapping, and of the seven palettes above v2 has two. One key covering both
  # would mean a setting whose preview lies in one interface or the other.
  #
  # Keys read by BOTH interfaces, and therefore not repeated here:
  #   station_id_overlay, station_id_color, min_span, default_buffer,
  #   band_color_intensity, spectrum_bg_opacity (+ the uploaded image)
  #
  # Every key below is optional, and leaving one out is meaningful: it means the
  # operator has not chosen, so v2 uses its own default — which is not the same
  # as writing that default out here, because writing it out freezes it. A key
  # that is set applies only to a visitor whose browser has no display settings
  # of its own; anyone who has picked a palette keeps theirs.
  #
  # These are normally set from the admin UI's UI tab, which builds its controls
  # from the interface's own option lists. Set by hand at your own risk: a value
  # v2 does not recognise is ignored by the client and rejected by the admin API.
  #
  # v2:
  #   # ── Interface ──
  #   # One of v2's colour schemes, as its Colours menu lists them. Carries the
  #   # accent, the text colours and whether the page is dark or light.
  #   # One of: default (UberSDR), contrast (High contrast), amber, phosphor,
  #   #         night, ice, violet, mono, paper (the light one).
  #   color_scheme: "default"
  #   # Multiplier on every font size, as the top bar's A- / A+ buttons set.
  #   # 0.75-1.6. v2 default: 1.
  #   ui_scale: 1.0
  #
  #   # ── Spectrum and waterfall ──
  #   # Waterfall colour map. One of: turbo, viridis, inferno, magma, classic,
  #   # mono, ice, radar. v2 default: classic. (Not the same list as `palette`
  #   # above, which is the classic interface's.)
  #   palette: "classic"
  #   # Gamma on the amplitude-to-colour mapping: below 1 lifts weak signals,
  #   # above 1 darkens the noise. 0.4-2.5. v2 default: 1.
  #   contrast: 1.0
  #   # Which panes the display opens with: split, spectrum, waterfall.
  #   view_mode: "split"
  #   # How the history is drawn: 2d (heat map), 3d (perspective), both.
  #   waterfall_mode: "2d"
  #   # Seconds of history the 3D surface reaches back. 1-30. Only applies where
  #   # waterfall_mode is 3d or both.
  #   dss_seconds: 10
  #   # What existing rows do when the view is dragged or zoomed:
  #   #   follow — rows shift with the axis, so a signal keeps its column
  #   #   hold   — rows stay where they were painted, as the classic interface does
  #   waterfall_pan: "follow"
  #   # Committed rows per second. 2-40. v2 default: 20.
  #   waterfall_rate: 20
  #   # Device pixels per waterfall row. 1-4. v2 default: 2.
  #   row_height: 2
  #   # Temporal averaging of the spectrum trace, 0 being off. 0-0.92.
  #   # v2 default: 0.5. (Not the classic interface's `smoothing`, which is spatial.)
  #   smoothing: 0.5
  #   # Slide each new row into view rather than letting it appear in one frame.
  #   # The classic interface calls this GPU sub-pixel scroll. v2 default: true.
  #   smooth_scroll: true
  #   # Hold the highest trace seen, decaying slowly. v2 default: false.
  #   peak_hold: false
  #   # Solid area beneath the spectrum line. v2 default: true.
  #   fill: true
  #   # dB gridlines across the spectrum pane. v2 default: false.
  #   grid: false
  #
  #   # ── Messages to visitors ──
  #   # Up to three short messages shown to everyone who opens the receiver,
  #   # stacked at the top of the page and gone again after a few seconds each.
  #   # Set them in Admin → UI, or here. They take effect on the next page load
  #   # — no restart.
  #   #
  #   # A list rather than one message because the two cases this exists for are
  #   # not the same kind of thing: an outage warning is temporary, amber and
  #   # worth repeating every load, while a donate button is permanent, quiet and
  #   # worth showing once. One card holding both reads as "donate towards the
  #   # outage".
  #   #
  #   # Plain text and at most one link each, deliberately: no HTML. An operator
  #   # can already put markup on the page through admin.description and
  #   # server.custom_body_html, but this file is exported and imported as a unit
  #   # (/admin/ui-config-export), and a notice made of markup would turn
  #   # importing somebody's colour scheme into importing their script.
  #   #
  #   # A message carrying a link_url is never shown in the iOS and Android
  #   # apps, whatever is set here: a donate button inside an app-store build is
  #   # a payment link the stores require to go through their own billing, and
  #   # those apps open whichever receiver the listener picked. A message with no
  #   # link breaks no such rule and is shown everywhere, apps included.
  #   notices:
  #     - enabled: true
  #       # info (accent), warning (amber) or good (green). Default: info.
  #       severity: "warning"
  #       title: "Antenna maintenance"
  #       text: "Reception may be impacted until 18:00 UTC."
  #       # Seconds on screen. 0-60, default 3; 0 means it stays until dismissed.
  #       # The countdown pauses while the pointer is on the notice.
  #       timeout_seconds: 5
  #       # every-load (default), or once — once per browser, until the wording
  #       # changes, at which point it is a new notice and is shown again.
  #       repeat: "every-load"
  #       # Whether it has a close button. Default: true. Forced on when
  #       # timeout_seconds is 0, since it would otherwise never go away.
  #       dismissible: true
  #     - enabled: true
  #       title: "Support this receiver"
  #       text: "Running costs are met by listeners like you."
  #       # Optional call to action. http, https or mailto only; opens in a new
  #       # tab. A PayPal donate button is this and nothing else.
  #       link_url: "https://www.paypal.com/donate?hosted_button_id=XXXXXXXX"
  #       link_label: "Donate"
  #       timeout_seconds: 0
  #       repeat: "once"
